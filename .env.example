# Salin jadi .env.local untuk dicoba di laptop. Di Vercel, isi lewat
# Project > Settings > Environment Variables. Panduan lengkap: docs/penyimpanan-online.md

# Kata sandi masuk /admin. Wajib; tanpa ini admin terkunci.
ADMIN_PASSWORD=

# Kunci tanda tangan sesi login, string acak panjang (mis. hasil `openssl rand -hex 32`).
# Jangan diganti setelah dipakai: alamat data admin di Blob diturunkan dari kunci ini.
# Pakai kunci berbeda untuk Preview supaya coba-coba di Preview tidak menyentuh data Production.
ADMIN_SESSION_SECRET=

# Diisi otomatis oleh Vercel waktu Blob store disambungkan ke project.
# Kosong di laptop = data disimpan di folder .data/ (mode uji lokal).
BLOB_READ_WRITE_TOKEN=
